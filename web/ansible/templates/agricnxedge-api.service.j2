[Unit]
Description=AgriCNXEdge FastAPI inference service
After=network.target

[Service]
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_dir }}/backend
Environment=APP_ENV=production
Environment=MODEL_PATH={{ app_dir }}/backend/models/adc_student_full.onnx
Environment=CORS_ORIGINS={{ cors_origins }}
ExecStart={{ app_dir }}/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port {{ backend_port }} --workers 1 --proxy-headers
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
